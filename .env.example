# Copy to .env and adjust. Every setting has a default; see app/config.py.
DATABASE_URL=postgresql+asyncpg://agrobot:agrobot@localhost:5432/agrobot
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
FORECAST_TIMEZONE=America/Argentina/Buenos_Aires
EVALUATION_INTERVAL_SECONDS=300
EVALUATION_HORIZON_DAYS=7
ALERT_MIN_AFFECTED_AREA=0.10
WEATHER_GRID_DEGREES=0.25
ZONE_RESOLVE_INTERVAL_SECONDS=60
ZONE_RESOLVE_BATCH_SIZE=20
ZONE_SAMPLE_MAX_POINTS=400
WEATHER_PROVIDER_TIMEOUT_SECONDS=10
DISPATCH_INTERVAL_SECONDS=15
DISPATCH_BATCH_SIZE=20
NOTIFIER_TIMEOUT_SECONDS=10
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_BACKOFF_BASE_SECONDS=60
NOTIFICATION_BACKOFF_MAX_SECONDS=3600
LOG_LEVEL=INFO
LOG_FORMAT=json
